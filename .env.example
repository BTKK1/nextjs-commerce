# Bagisto API Configuration
NEXT_PUBLIC_BAGISTO_ENDPOINT=https://your-bagisto-instance.com
NEXT_PUBLIC_BAGISTO_STOREFRONT_KEY=your_storefront_key_here

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_next_auth_secret_here

# Application Settings
COMPANY_NAME=Your Company Name

# Saleh AI Sales Agent Demo
OPENROUTER_API_KEY=
# Same route order as Ting CRM Sales Helper Agent `sales_agent_chat`.
SALES_AGENT_MODEL=google/gemini-2.5-flash-lite
SALES_AGENT_FALLBACK_MODEL=qwen/qwen3-235b-a22b-2507
SALES_AGENT_FALLBACK2_MODEL=deepseek-chat
# Backward-compatible aliases; SALES_AGENT_* wins when both are set.
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
PRODUCT_AGENT_MODEL=google/gemini-2.5-flash-lite
PRODUCT_AGENT_FALLBACK_MODEL=qwen/qwen3-235b-a22b-2507
PRODUCT_AGENT_FALLBACK2_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Saleh Stores AI Sales Agent Demo
NEXT_PUBLIC_DEMO_MODE=true
# Shopper responses always use the live LLM route. There is no scripted-answer mode.
AGENT_MODE=live
AGENT_QUALITY_MODE=live
SUPABASE_AGENT_ENABLED=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[REGION].pooler.supabase.com:5432/postgres"
DEMO_DATA_FILE=
