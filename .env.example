# Bagisto API Configuration
NEXT_PUBLIC_BAGISTO_ENDPOINT=https://your-bagisto-instance.com
NEXT_PUBLIC_BAGISTO_STOREFRONT_KEY=your_storefront_key_here

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_next_auth_secret_here

# Application Settings
COMPANY_NAME=Your Company Name

# Nbeh AI Sales Agent
OPENROUTER_API_KEY=
# Same route order as Ting CRM Sales Helper Agent `sales_agent_chat`.
SALES_AGENT_MODEL=google/gemini-2.5-flash-lite
SALES_AGENT_FALLBACK_MODEL=qwen/qwen3-235b-a22b-2507
SALES_AGENT_FALLBACK2_MODEL=deepseek-chat
SALES_AGENT_DISABLE_FALLBACKS=false
# Backward-compatible aliases; SALES_AGENT_* wins when both are set.
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
PRODUCT_AGENT_MODEL=google/gemini-2.5-flash-lite
PRODUCT_AGENT_FALLBACK_MODEL=qwen/qwen3-235b-a22b-2507
PRODUCT_AGENT_FALLBACK2_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Nbeh AI
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true
# Shopper responses always use the live LLM route. There is no scripted-answer mode.
AGENT_MODE=live
AGENT_QUALITY_MODE=live
# Must be true whenever DATA_BACKEND=supabase; production fails closed otherwise.
SUPABASE_AGENT_ENABLED=true
# Server-only HMAC key (32+ random characters). It pseudonymizes the trusted
# edge client address for durable abuse limits; raw addresses are never stored.
AGENT_RATE_LIMIT_SECRET=
# Self-hosted only: enable after a trusted reverse proxy strips and rewrites
# x-forwarded-for/x-real-ip. Vercel uses its normalized platform header instead.
TRUST_PROXY_IP_HEADERS=false
# Data backend: `supabase` for deployed/merchant mode, `local` for isolated tests and offline development.
# When omitted, Supabase is selected automatically if its server credentials are present.
DATA_BACKEND=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alias accepted by the clients when a project still uses anon keys.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only. Supabase's new `sb_secret_...` key belongs here; never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[REGION].pooler.supabase.com:5432/postgres"
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[REGION].pooler.supabase.com:5432/postgres"
# Optional seed mapping. Create the Supabase Auth user first, then paste its UUID here.
SEED_OWNER_USER_ID=
# Public embed/runtime identity for the temporary pilot merchant. Production merchants receive unique values in Supabase.
NEXT_PUBLIC_DEMO_MERCHANT_KEY=demo-maison-vert
# Platform integration placeholders. Set only after Salla/Zid app approval; secrets stay server-side.
INTEGRATION_STATE_SECRET=
WIDGET_SIGNING_SECRET=
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
# Salla Easy Mode sends credentials through the signed app.store.authorize webhook.
# This is the merchant-facing app installation URL, not an OAuth callback URL.
SALLA_INSTALL_URL=https://s.salla.sa/apps/install/1132747795
SALLA_REDIRECT_URI=
SALLA_AUTHORIZE_URL=
SALLA_TOKEN_URL=
SALLA_WEBHOOK_SECRET=
ZID_CLIENT_ID=
ZID_CLIENT_SECRET=
ZID_REDIRECT_URI=https://www.nbeh.io/api/integrations/zid/oauth/callback
ZID_AUTHORIZE_URL=https://oauth.zid.sa/oauth/authorize
ZID_TOKEN_URL=https://oauth.zid.sa/oauth/token
ZID_WEBHOOK_SECRET=
DEMO_DATA_FILE=
