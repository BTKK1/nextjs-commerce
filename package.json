{
  "name": "nbeh-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typegen": "next typegen",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration/agent-api.test.ts tests/integration/agent-eval.test.ts tests/integration/supabase-runtime.test.ts tests/integration/platform-routes.test.ts",
    "test:agent": "vitest run tests/integration/agent-eval.test.ts",
    "test:agent:quality": "node scripts/run-agent-quality-matrix.mjs",
    "test:agent:live": "node scripts/run-agent-quality-matrix.mjs --live",
    "test:agent:continuous": "vitest run tests/integration/continuous-agent-smoke.test.ts",
    "qa:live-agent": "node scripts/live-agent-qa.mjs",
    "qa:live-agent:loop": "node scripts/live-agent-qa.mjs",
    "qa:live-agent:api": "node scripts/live-agent-qa.mjs --api-only",
    "qa:live-agent:widget": "node scripts/live-agent-qa.mjs --widget-only",
    "qa:live-agent:dashboard": "node scripts/live-agent-qa.mjs --dashboard-only",
    "qa:live-agent:report": "node scripts/live-agent-qa.mjs --report-only",
    "test:live-agent": "node scripts/live-agent-qa.mjs",
    "test:live-agent:arabic": "node scripts/live-agent-qa.mjs --language=ar",
    "test:live-agent:english": "node scripts/live-agent-qa.mjs --language=en",
    "test:live-agent:safety": "node scripts/live-agent-qa.mjs --scenario=safety",
    "test:live-agent:dashboard": "node scripts/live-agent-qa.mjs --dashboard-only",
    "handoff:live-agent": "node scripts/live-agent-handoff.mjs",
    "test:agent:scenarios": "vitest run tests/integration/agent-client-scenarios.test.ts",
    "backend:check": "prisma validate --config=./prisma.config.ts",
    "supabase:push": "pnpm run supabase:migrate",
    "supabase:migrate": "pnpm run supabase:migrate:base && pnpm run supabase:migrate:platform && pnpm run supabase:migrate:runtime && pnpm run supabase:migrate:abuse && pnpm run supabase:migrate:wallet && pnpm run supabase:migrate:beta",
    "supabase:migrate:base": "supabase db query --linked --file supabase/migrations/202608030001_dashboard_sprint.sql --agent no",
    "supabase:migrate:platform": "supabase db query --linked --file supabase/migrations/202608030002_platform_foundation.sql --agent no",
    "supabase:migrate:runtime": "supabase db query --linked --file supabase/migrations/202608130003_agent_runtime_hardening.sql --agent no",
    "supabase:migrate:abuse": "supabase db query --linked --file supabase/migrations/202608130004_abuse_controls.sql --agent no",
    "supabase:migrate:wallet": "supabase db query --linked --file supabase/migrations/202608220005_token_wallet_defaults.sql --agent no",
    "supabase:migrate:beta": "supabase db query --linked --file supabase/migrations/202608220006_beta_readiness.sql --agent no && supabase db query --linked --file supabase/migrations/202608220007_fix_agent_insight_signal_operators.sql --agent no && supabase db query --linked --file supabase/migrations/202608220008_token_wallet_full_usage.sql --agent no && supabase db query --linked --file supabase/migrations/202608220009_upgrade_global_agent_prompt.sql --agent no && supabase db query --linked --file supabase/migrations/202608220010_enforce_direct_compatibility_answers.sql --agent no && supabase db query --linked --file supabase/migrations/202608220011_strengthen_objection_and_gift_guidance.sql --agent no && supabase db query --linked --file supabase/migrations/202608230012_atomic_prompt_draft_save.sql --agent no && supabase db query --linked --file supabase/migrations/202608250001_founder_beta_token_allowance.sql --agent no",
    "supabase:seed": "node scripts/seed-supabase.mjs",
    "catalog:import:csv": "node scripts/import-catalog-csv.mjs",
    "supabase:reset-demo": "node scripts/seed-supabase.mjs --reset",
    "supabase:verify": "node scripts/verify-supabase-rls.mjs",
    "platform:verify": "node scripts/verify-platform-foundation.mjs",
    "beta:capacity": "node scripts/verify-beta-capacity.mjs",
    "db:types": "node scripts/write-supabase-types.mjs",
    "qa:agent-config": "node scripts/qa-agent-config.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "smoke:production:commerce": "node scripts/verify-production-commerce.mjs",
    "qa:production-agent": "node scripts/verify-production-agent-quality.mjs",
    "test:e2e:server": "node scripts/start-playwright-server.mjs",
    "test:e2e": "playwright test",
    "test:e2e:agent": "playwright test tests/e2e/agent-shopping.spec.ts tests/e2e/platform-embed.spec.ts",
    "test:e2e:product-pages": "playwright test tests/e2e/storefront-products.spec.ts tests/e2e/demo.spec.ts",
    "test:e2e:dashboard": "playwright test tests/e2e/dashboard-insights.spec.ts",
    "screenshots:products": "node scripts/capture-product-screenshots.mjs",
    "audit:product-pages": "node scripts/audit-product-pages.mjs",
    "audit:dashboard": "node scripts/audit-dashboard.mjs",
    "audit:agent": "node scripts/run-agent-quality-matrix.mjs",
    "audit:screenshots": "node scripts/capture-product-screenshots.mjs",
    "generate:demo-assets": "node scripts/generate-demo-assets.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "secrets:check": "node scripts/check-secrets.mjs",
    "handoff:check": "node scripts/handoff-check.mjs",
    "handoff:loop": "node scripts/handoff-loop.mjs",
    "ci": "pnpm run handoff:check",
    "package-version": "npx npm-check-updates"
  },
  "engines": {
    "node": ">=20"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@apollo/client": "^4.2.3",
    "@heroicons/react": "^2.2.0",
    "@heroui/accordion": "^2.2.29",
    "@heroui/alert": "^2.2.32",
    "@heroui/avatar": "^2.2.26",
    "@heroui/drawer": "^2.2.29",
    "@heroui/popover": "^2.3.32",
    "@heroui/react": "^2.8.6",
    "@heroui/select": "^2.4.33",
    "@heroui/switch": "^2.2.27",
    "@heroui/system": "^2.4.28",
    "@react-aria/visually-hidden": "^3.9.1",
    "@react-types/shared": "^3.36.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "@vercel/blob": "^2.8.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "graphql": "^17.0.1",
    "lucide-react": "^1.21.0",
    "next": "^16.2.9",
    "next-auth": "^4.24.14",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "react-redux": "^9.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.13.0",
    "eslint": "^10",
    "eslint-config-next": "16.2.9",
    "jsdom": "^28.0.1",
    "lint-staged": "^17.0.8",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^6",
    "vitest": "^4.1.10"
  }
}
